, and area, including combining those filters. Prefer filtering by domain when searching for multiple devices of the same type.\"}, {\"name\": \"intent__HassTurnOn\", \"parameters\": {\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\"}, \"area\": {\"type\": \"string\"}, \"floor\": {\"type\": \"string\"}, \"domain\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"device_class\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"tv\", \"speaker\", \"receiver\", \"projector\", \"awning\", \"blind\", \"curtain\", \"damper\", \"door\", \"⟦545⟧\", \"gate\", \"shade\", \"shutter\", \"window\", \"identify\", \"restart\", \"update\", \"outlet\", \"switch\", \"water\", \"gas\"]}}}, \"additionalProperties\": ⟦576⟧}, \"description\": \"Turns on/⟦590⟧s/presses a device or entity. For ⟦587⟧s, this performs a '⟦587⟧' action. Use for requests like 'turn on', 'activate', 'enable', or '⟦587⟧'.\"}, {\"name\": \"intent__HassTurnOff\", \"parameters\": {\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\"}, \"area\": {\"type\": \"string\"}, \"floor\": {\"type\": \"string\"}, \"domain\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"device_class\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"enum\": [\"tv\", \"speaker\", \"receiver\", \"projector\", \"awning\", \"blind\", \"curtain\", \"damper\", \"door\", \"⟦545⟧\", \"gate\", \"shade\", \"shutter\", \"window\", \"identify\", \"restart\", \"update\", \"outlet\", \"switch\", \"water\", \"gas\"]}}}, \"additionalProperties\": ⟦576⟧}, \"description\": \"Turns off/closes a device or entity. For ⟦587⟧s, this performs an 'un⟦587⟧' action. Use for requests like 'turn off', 'deactivate', 'disable', or 'un⟦587⟧'.\"}, {\"name\": \"intent__HassCancelAllTimers\", \"parameters\": {\"type\": \"object\", \"properties\": {\"area\": {\"type\": \"string\"}}, \"additionalProperties\": ⟦576⟧}, \"description\": \"Cancels all timers\"}, {\"name\": \"llm__GetDateTim
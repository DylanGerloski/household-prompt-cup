[{"id": "forge/prompts_v1.json/P1", "text": "Turn things on and off in the house.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "forge/prompts_v1.json/P2", "text": "you are my home assistant, i say things like turn off the ⟦577⟧ or make it warmer, just do what i mean and dont ask me questions", "rows": [["GENERIC_DOMAIN", "⟦577⟧", "⟦429⟧,⟦321⟧,⟦433⟧", "s like turn off the ⟦577⟧ or make it warmer, "]], "exit": 2, "last_line": "UNDECIDED: the only hits are bare domain words that are also ordinary English. Whether the rule reaches them is FORGE's and ARCHITECT's, not this file's and not the dispatcher's. Nothing is cleared and nothing is dropped until that is said."}, {"id": "forge/prompts_v1.json/P3", "text": "Make exactly one tool call. Use only names that appear in the tool descriptions. Leave every optional field out unless the request names it.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "forge/prompts_v1.json/P4", "text": "Pick the single most likely device for the request and act on it. If you are unsure between two actions, do the simpler one.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "forge/prompts_v1.json/P5", "text": "PLEASE JUST DO WHAT I SAY. Quick.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "forge/prompts_v2.json/P6", "text": "Understand what each command asks for and match it to the available control that best performs the request. If multiple controls could work, select the most likely option. Output only that control as shown in the controls list. Provide no explanation.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "forge/prompts_v2.json/P7", "text": "Identify the user's intent in the spoken command. Match it to a single control from the provided list that executes this intent. Reply with only the control call, nothing else. If no match, return nothing.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "forge/prompts_v2.json/P8", "text": "You control a smart home. Read the spoken command, then choose the single control from the list below that best matches what the person wants. Call it with exactly the right action and values: on or off, the number or level asked for, or a state query when they ask a question. Use only names and settings that appear in the list, copied exactly. Make one call and add no extra text.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "forge/prompts_v2.json/P9", "text": "You control a smart home. Read the spoken command, then look at the list of available controls that follows. Choose the single control that best matches what the person wants, and call it with the right arguments. Match the device and place named in the command to the list, and copy names exactly as listed. Turn on, off, ⟦590⟧, close, set, or query as requested. Use numbers the person gave. Reply with only the call.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "forge/prompts_v2.json/P10", "text": "You control a smart home. Read the user's command and the list of available controls below. Reply with exactly one control call and nothing else. Pick the control whose name and purpose best match the command. Use only control names and argument names exactly as listed. Copy device, room and value words from the command into the arguments, keeping their spelling. Include only arguments the command needs. For questions about the home's state, use the matching status or query control.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "forge/prompts_v2.json/P11", "text": "You control a smart home. Read the user's command and the list of available controls below. Reply with exactly one control call and nothing else. Choose the control whose name and purpose best match the command. Copy names and entity IDs exactly as listed; never invent one. Fill every required argument using values from the command, converting words to numbers where needed. For questions about the home's state, call the matching status control. If unsure, pick the closest match.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "forge/prompts_v2.json/P12", "text": "You are a smart-home voice assistant. Given a spoken command and the list of available controls below, output exactly one control call that best fulfills the command. Recognize synonyms: on/off, up/down, bright/dim, warm/cool, ⟦590⟧/close, ⟦587⟧/un⟦587⟧. For questions about current state, use the matching status or read control. When multiple controls could match, pick the most specific one. Output only the control call with no explanation.", "rows": [["GENERIC_DOMAIN", "⟦587⟧", "⟦444⟧", "m/cool, ⟦590⟧/close, ⟦587⟧/un⟦587⟧. For questio"]], "exit": 2, "last_line": "UNDECIDED: the only hits are bare domain words that are also ordinary English. Whether the rule reaches them is FORGE's and ARCHITECT's, not this file's and not the dispatcher's. Nothing is cleared and nothing is dropped until that is said."}, {"id": "forge/prompts_v2.json/P13", "text": "Read the spoken command and the list of controls. Choose the single control call that best carries out the command. Match the control whose name and function fit the user's intent, and fill in every required value from what the user said (the target, the setting, the level, or the state). If the command asks about status, select the control that reports state. Reply with exactly one control call and nothing else.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "selftest/0", "text": "Turn on the ⟦346⟧ now.", "rows": [["SPECIFIC", "⟦346⟧", "⟦420⟧", "Turn on the ⟦346⟧ now."], ["SPECIFIC", "⟦355⟧", "⟦420⟧", "Turn on the ⟦346⟧ now."]], "exit": 1, "last_line": "FAIL: a prompt carries a name peculiar to this home. Architect #13564 item 2: it is DROPPED from the five, not re-worded. This file does not drop it."}, {"id": "selftest/1", "text": "act in the ⟦485⟧", "rows": [["SPECIFIC", "⟦471⟧", "⟦429⟧,⟦420⟧,⟦433⟧,home7-dk-⟦574⟧", "act in the ⟦485⟧"], ["SPECIFIC", "⟦486⟧", "⟦429⟧,⟦420⟧,⟦433⟧,home7-dk-⟦574⟧", "act in the ⟦485⟧"]], "exit": 1, "last_line": "FAIL: a prompt carries a name peculiar to this home. Architect #13564 item 2: it is DROPPED from the five, not re-worded. This file does not drop it."}, {"id": "selftest/2", "text": "call ⟦255⟧", "rows": [["GENERIC_DOMAIN", "⟦550⟧", "⟦420⟧", "call ⟦255⟧"], ["SPECIFIC", "⟦255⟧", "⟦420⟧", "call ⟦255⟧"]], "exit": 1, "last_line": "FAIL: a prompt carries a name peculiar to this home. Architect #13564 item 2: it is DROPPED from the five, not re-worded. This file does not drop it."}, {"id": "selftest/3", "text": "turn off the ⟦577⟧", "rows": [["GENERIC_DOMAIN", "⟦577⟧", "⟦429⟧,⟦321⟧,⟦433⟧", "turn off the ⟦577⟧"]], "exit": 2, "last_line": "UNDECIDED: the only hits are bare domain words that are also ordinary English. Whether the rule reaches them is FORGE's and ARCHITECT's, not this file's and not the dispatcher's. Nothing is cleared and nothing is dropped until that is said."}, {"id": "selftest/4", "text": "Make exactly one tool call.", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "selftest/5", "text": "be quick, it is five o'c⟦587⟧", "rows": [], "exit": 0, "last_line": "PASS: no prompt carries a device, area or entity name from the home."}, {"id": "selftest/6", "text": "that is fantastic, go ahead", "rows